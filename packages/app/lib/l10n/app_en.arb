  "@elementWheelRestrain": {"placeholders": {"mult": {"type": "String"}}},
  "guideTitle": "Guidebook",
  "guideIntro": "Every bug is different even within a species. Tap a topic to see what each term means.",
  "guideElementTitle": "Elements (Wood·Fire·Earth·Metal·Water)",
  "@guideElementBody": {"placeholders": {"mult": {"type": "String"}}},
  "guideElementBody": "Each bug has one element. In duels, when a bug clashes with an element it restrains, it deals {mult}x damage. The red arrows show who beats whom.",
  "@guideElementLine": {"placeholders": {"a": {"type": "String"}, "b": {"type": "String"}}},
  "guideElementLine": "{a} beats {b}",
  "guideSpecialtyTitle": "Specialty (fighting style)",
  "guideSpecialtyBody": "Each species has a specialty that decides how it fights in duels.",
  "guideSpecialtyStrike": "Charges in to ram and flip the opponent.",
  "guideSpecialtyGrip": "Bites and holds on, pushing the opponent out.",
  "guideSpecialtyToss": "Lifts the opponent and throws it.",
  "guideTemperamentTitle": "Temperament (fighting tendency)",
  "guideTemperamentBody": "Temperament decides how a bug moves in duels and which stats it can train higher.",
  "guideTempAggressive": "Charges often — an attacker.",
  "guideTempCautious": "Avoids the edge and sidesteps charges.",
  "guideTempCunning": "Circles to the side to hit weak spots.",
  "guideTempSteadfast": "Hard to push — a tank.",
  "guideTempFickle": "Mixes all styles.",
  "@guideTrainCapMods": {"placeholders": {"mods": {"type": "String"}}},
  "guideTrainCapMods": "Training cap: {mods}",
  "guideSizeTitle": "Size (weight)",
  "@guideSizeBody": {"placeholders": {"min": {"type": "String"}, "max": {"type": "String"}}},
  "guideSizeBody": "Size is rolled within the species' range. Bigger bugs get stats ×{min}~×{max}, are harder to push and less likely to fall out of the ring in duels.",
  "guidePotentialTitle": "Potential (1–5 stars)",
  "@guidePotentialBody": {"placeholders": {"perStar": {"type": "int"}, "fodder": {"type": "int"}}},
  "guidePotentialBody": "Higher stars raise the part-enhance max level (stars × 10) and the training cap (+{perStar} per star). Merge {fodder} bugs of the same species to gain a star.",
  "guideTraitTitle": "Bloodline traits (breeding only)",
  "guideTraitBody": "Only bugs born from breeding can have a trait — wild bugs never do. Traits work both as a pet and in duels.",
  "@guideTraitEffect": {"placeholders": {"atk": {"type": "String"}, "hp": {"type": "String"}}},
  "guideTraitEffect": "Attack +{atk} · HP +{hp}",
  "guideBreedTitle": "Breeding & inheritance",
  "@guideBreedBody": {"placeholders": {"el": {"type": "String"}, "tm": {"type": "String"}, "tr": {"type": "String"}}},
  "guideBreedBody": "Pair a male and female adult of the same species to get an egg. The child inherits the parents' element ({el}) and temperament ({tm}) with high chance, and a parent's trait ({tr}). If both parents share the same element, temperament or trait, the child is guaranteed to get it — so you can build your own line.",
  "guideVariantTitle": "Variant bugs",
  "@guideVariantBody": {"placeholders": {"wild": {"type": "String"}, "breed": {"type": "String"}, "parent": {"type": "String"}, "gacha": {"type": "String"}, "pet": {"type": "String"}, "duel": {"type": "String"}}},
  "guideVariantBody": "Very rarely a bug with different colors (rainbow / albino) appears. Chance: wild {wild} · breeding {breed} · variant parent {parent} · egg draw {gacha}. As a pet its stats are +{pet}, in duels +{duel}.",
  "guideLifeTitle": "Life stages",
  "guideLifeBody": "Egg → Larva → Pupa → Adult. Eggs hatch into larvae only in the incubator. Larvae grow into adults over time. Only adults can be trained, bred and sent to duels.",
  "guideDuelTitle": "Duels",
  "@guideDuelBody": {"placeholders": {"sec": {"type": "int"}, "weak": {"type": "String"}}},
  "guideDuelBody": "A bout is a {sec}-second 1:1 physical fight in a round arena. Win by ring-out, flipping, or knockout; when time runs out, remaining HP % decides. A match is 3 bugs, winner stays on. Hitting the side or back deals ×{weak} damage, and critical hits and evasion also apply.",
  "guideTrainTitle": "Training ground",
  "@guideTrainBody": {"placeholders": {"base": {"type": "int"}}},
  "guideTrainBody": "Train 5 duel stats per bug: attack, defense, evasion, crit and recovery. Max stage = {base} + potential + temperament/specialty/trait bonuses, so every bug has its own strengths. Mix bugs with different roles in your team!",
