{
  "permissions": {
    "allow": [
      "Bash(flutter analyze)",
      "Bash(flutter analyze *)",
      "Bash(flutter test)",
      "Bash(flutter test *)",
      "Bash(flutter gen-l10n)",
      "Bash(flutter devices)",
      "Bash(flutter devices *)",
      "Bash(dart analyze)",
      "Bash(dart analyze *)",
      "Bash(dart test)",
      "Bash(dart test *)",
      "Bash(dart format *)",
      "Bash(dart pub get)",
      "Bash(dart run tool/*)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud run services describe *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/tool/hook_arch_guard.dart\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/tool/hook_post_edit.dart\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
